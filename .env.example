# Copy to .env and fill in. Never commit .env.

# --- Backend server ---
NUDGY_ENV=dev
NUDGY_DATABASE_URL=sqlite:///./nudgy.db
NUDGY_CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
# 32+ random chars in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
NUDGY_JWT_SECRET=change-me
# Public URL used in share links and sign-in callbacks
NUDGY_PUBLIC_URL=http://127.0.0.1:8787

# Business details: shown on /privacy, /terms, /cookies, /delete-account, the page footer and in
# the app (Settings -> About). Required outside dev. Contact email receives privacy and
# deletion requests.
NUDGY_COMPANY_NAME=
NUDGY_COMPANY_ADDRESS=
NUDGY_COMPANY_COUNTRY=
NUDGY_CONTACT_EMAIL=
# Optional site analytics script URL; loaded only after a visitor accepts the cookie banner.
NUDGY_ANALYTICS_SRC=
# Must be true in production (the server refuses to start otherwise)
NUDGY_AUTH_REQUIRED=false

# --- Launch and free access (DECISIONS D38) ---
# Day Nudgy ships (YYYY-MM-DD). Everyone gets unlimited use until LAUNCH_DATE + 365 days
# (FREE_UNTIL, one date for all accounts). Leave blank in dev: no free window, free accounts
# are on the capped tier.
NUDGY_LAUNCH_DATE=
# Optional: move FREE_UNTIL to this date instead (the admin API can also do this live).
NUDGY_FREE_UNTIL_OVERRIDE=
# Seeds the free-tier monthly lesson cap once; afterwards change it via PUT /v1/admin/access.
NUDGY_FREE_TIER_LESSONS_PER_MONTH=5
# Enables /v1/admin/* (header X-Admin-Token). 32+ random chars; blank = admin API off.
NUDGY_ADMIN_TOKEN=

# --- Provider selection ---
# LLM:  anthropic | local (Nudgy's built-in AI, no key) | fake (practice mode, sample answers)
# STT:  deepgram | openai_whisper | local_whisper (built-in) | fake
# TTS:  elevenlabs | openai_tts | system (the computer's own voice) | fake
# The desktop installer switches these to the built-in AI by itself once it's set up.
NUDGY_LLM_PROVIDER=fake
NUDGY_STT_PROVIDER=fake
NUDGY_TTS_PROVIDER=system
NUDGY_LLM_MODEL=claude-sonnet-5
# disabled | adaptive — thinking off keeps first audio under ~2.5 s
NUDGY_LLM_THINKING=disabled
# low | medium | high | (empty = provider default)
NUDGY_LLM_EFFORT=low

# --- Provider keys ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Sign-in ---
# console (logs magic links; dev only) | smtp
NUDGY_EMAIL_PROVIDER=console
NUDGY_EMAIL_FROM=Nudgy <hello@nudgy.app>
NUDGY_SMTP_HOST=
NUDGY_SMTP_PORT=587
NUDGY_SMTP_USER=
NUDGY_SMTP_PASSWORD=
NUDGY_GOOGLE_CLIENT_ID=
NUDGY_GOOGLE_CLIENT_SECRET=
NUDGY_APPLE_CLIENT_ID=
NUDGY_APPLE_TEAM_ID=
NUDGY_APPLE_KEY_ID=
NUDGY_APPLE_PRIVATE_KEY=

# --- Billing (PayPal subscriptions) ---
# developer.paypal.com → Apps & Credentials → your app (use the Sandbox tab while testing)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (URL: https://<server>/v1/billing/webhook)
PAYPAL_WEBHOOK_ID=
# Plan IDs ("P-…") from PayPal → Subscriptions → Plans: Nudgy Pro $20/month and $40/year
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_PRO_YEARLY=
# Optional per-seat Team plan
PAYPAL_PLAN_TEAM=

# --- Built-in AI (set by the desktop app when it starts its engines) ---
NUDGY_LOCAL_LLM_URL=http://127.0.0.1:8790
NUDGY_LOCAL_STT_URL=http://127.0.0.1:8791
# How many on-screen elements are sent to the model (80 for the built-in AI, up to 400)
NUDGY_MAX_ELEMENTS=400
