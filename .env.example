# Copy to .env and fill in. Never commit .env.

# --- Backend server ---
NUDGY_ENV=dev
NUDGY_DATABASE_URL=sqlite:///./nudgy.db
NUDGY_CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
# 32+ random chars in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
NUDGY_JWT_SECRET=change-me
# Public URL used in share links and sign-in callbacks
NUDGY_PUBLIC_URL=http://127.0.0.1:8787
# Must be true in production (the server refuses to start otherwise)
NUDGY_AUTH_REQUIRED=false

# --- Launch and free access (DECISIONS D38) ---
# Day Nudgy ships (YYYY-MM-DD). Everyone gets unlimited use until LAUNCH_DATE + 365 days
# (FREE_UNTIL, one date for all accounts). Leave blank in dev: no free window, free accounts
# are on the capped tier.
NUDGY_LAUNCH_DATE=
# Optional: move FREE_UNTIL to this date instead (the admin API can also do this live).
NUDGY_FREE_UNTIL_OVERRIDE=
# Seeds the free-tier monthly lesson cap once; afterwards change it via PUT /v1/admin/access.
NUDGY_FREE_TIER_LESSONS_PER_MONTH=5
# Enables /v1/admin/* (header X-Admin-Token). 32+ random chars; blank = admin API off.
NUDGY_ADMIN_TOKEN=

# --- Provider selection (anthropic|fake, deepgram|openai_whisper|fake, elevenlabs|openai_tts|fake) ---
NUDGY_LLM_PROVIDER=fake
NUDGY_STT_PROVIDER=fake
NUDGY_TTS_PROVIDER=fake
NUDGY_LLM_MODEL=claude-sonnet-5
# disabled | adaptive — thinking off keeps first audio under ~2.5 s
NUDGY_LLM_THINKING=disabled
# low | medium | high | (empty = provider default)
NUDGY_LLM_EFFORT=low

# --- Provider keys ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Sign-in ---
# console (logs magic links; dev only) | smtp
NUDGY_EMAIL_PROVIDER=console
NUDGY_EMAIL_FROM=Nudgy <hello@nudgy.app>
NUDGY_SMTP_HOST=
NUDGY_SMTP_PORT=587
NUDGY_SMTP_USER=
NUDGY_SMTP_PASSWORD=
NUDGY_GOOGLE_CLIENT_ID=
NUDGY_GOOGLE_CLIENT_SECRET=
NUDGY_APPLE_CLIENT_ID=
NUDGY_APPLE_TEAM_ID=
NUDGY_APPLE_KEY_ID=
NUDGY_APPLE_PRIVATE_KEY=

# --- Billing (Stripe; use test-mode keys in development) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_COUPON_STUDENT=
