# Copy to .env and fill in. Never commit .env.

# --- Backend server ---
NUDGY_ENV=dev
NUDGY_DATABASE_URL=sqlite:///./nudgy.db
NUDGY_CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
NUDGY_JWT_SECRET=change-me

# --- Provider selection (anthropic|fake, deepgram|openai_whisper|fake, elevenlabs|openai_tts|fake) ---
NUDGY_LLM_PROVIDER=fake
NUDGY_STT_PROVIDER=fake
NUDGY_TTS_PROVIDER=fake
NUDGY_LLM_MODEL=claude-sonnet-5
# disabled | adaptive — thinking off keeps first audio under ~2.5 s
NUDGY_LLM_THINKING=disabled
# low | medium | high | (empty = provider default)
NUDGY_LLM_EFFORT=low

# --- Provider keys ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Billing (Phase 7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
