{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nudgy",
  "version": "0.1.0",
  "identifier": "app.nudgy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nudgy",
        "width": 980,
        "height": 780,
        "resizable": true,
        "visible": false,
        "center": true,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nudgy"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/heyanandu08-max/Nudgy/releases/latest/download/latest.json"
      ]
    }
  }
}
